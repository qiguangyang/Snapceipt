<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Debug/dev builds use automatic signing, whose dev profiles carry
	     aps-environment=development. Release uses Snapceipt.Release.entitlements
	     (production) because manual signing with the match App Store profile
	     validates this file's value against the profile. -->
	<!-- In-App Purchase (StoreKit 2 Pro tier) needs NO entitlement-file key:
	     the capability lives on the App ID, and StoreKit works without one.
	     A com.apple.developer.in-app-purchase key fails App Store archive
	     validation ("not a valid entitlement"), so it is intentionally absent. -->
	<!-- App Attest: the six auth-bootstrap requests carry a DeviceCheck App Attest
	     assertion the backend can verify. Dev/TestFlight builds attest against the
	     `development` environment; Release uses `production` (Snapceipt.Release.entitlements). -->
	<key>com.apple.developer.devicecheck.appattest-environment</key>
	<string>development</string>
	<key>aps-environment</key>
	<string>development</string>
	<!-- Shared container with the Share Extension: it drops receipts shared from other apps
	     here, and the main app drains them through the capture pipeline. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.snapceipt</string>
	</array>
</dict>
</plist>
