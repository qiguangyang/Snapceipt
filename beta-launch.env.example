# ============================================================================
# Snapceipt — TestFlight beta launch config
# ============================================================================
# HOW TO USE: edit beta-launch.env (the gitignored working copy of this file).
# Fill in each value, flip the CONFIRM_* flags to "yes" as you complete the
# manual browser steps, then tell Claude the config is filled. The remaining
# plan tasks (8–16 in docs/superpowers/plans/2026-06-10-testflight-beta-
# launch.md) consume these values: deploy the backend + site, set the Worker
# push secrets, bootstrap match, and upload the first TestFlight build.
#
# beta-launch.env is gitignored — real secrets never commit. This .example
# file is the committed template.
# ============================================================================

# ---- 1. Apple Developer Team ID ---------------------------------------------
# developer.apple.com → Account → Membership details → Team ID (10 characters).
# Used for: project.yml DEVELOPMENT_TEAM, fastlane FASTLANE_TEAM_ID, and the
# Worker secret APNS_TEAM_ID.
APPLE_TEAM_ID=

# ---- 2. DeepSeek API key ------------------------------------------------------
# platform.deepseek.com → API keys. Needs a funded balance (receipt extraction).
# Used for: the production deploy (Worker secret DEEPSEEK_API_KEY).
DEEPSEEK_API_KEY=

# ---- 3. APNs auth key ---------------------------------------------------------
# developer.apple.com → Certificates, Identifiers & Profiles → Keys → "+"
#   Name "Snapceipt APNs"; check "Apple Push Notifications service (APNs)";
#   Register → DOWNLOAD THE .p8 NOW (one-time download — also save it in your
#   password manager). The Key ID is shown on the key's page.
# Store the .p8 OUTSIDE the repo (e.g. ~/secrets/).
APNS_KEY_PATH=
APNS_KEY_ID=

# ---- 4. App Store Connect API key (for fastlane) ------------------------------
# appstoreconnect.apple.com → Users and Access → Integrations →
#   App Store Connect API → Team Keys → "+": name "fastlane", role App Manager.
#   Download the .p8 (one-time), note its Key ID, and the Issuer ID shown at
#   the top of that page.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=

# ---- 5. fastlane match cert storage -------------------------------------------
# Create a PRIVATE, EMPTY GitHub repo (suggested: qiguangyang/snapceipt-certs)
# and pick a strong passphrase; keep the passphrase in your password manager —
# losing it means `fastlane match nuke distribution` + re-bootstrap.
MATCH_GIT_URL=git@github.com:qiguangyang/snapceipt-certs.git
MATCH_PASSWORD=

# ---- Manual browser steps (flip to "yes" as you finish each) -------------------
# A. Cloudflare zone — DO THIS FIRST, DNS propagation is the longest pole:
#    dash.cloudflare.com (techsiderau@gmail.com account) → Add a domain →
#    snapceipt.cc → switch the nameservers at your registrar.
CONFIRM_CLOUDFLARE_ZONE_ADDED=no

# B. Wrangler login on this machine:  npx --yes wrangler@4 login
#    (log into the techsiderau account)
CONFIRM_WRANGLER_LOGIN=no

# C. Apple App ID: developer.apple.com → Identifiers → "+" → App IDs → App →
#    explicit bundle ID "app.snapceipt.Snapceipt", description "Snapceipt";
#    enable capabilities: Sign In with Apple AND Push Notifications → Register.
CONFIRM_APP_ID_REGISTERED=no

# D. ASC app record: appstoreconnect.apple.com → My Apps → "+" → New App:
#    platform iOS, name "Snapceipt" (fallback "Snapceipt — Receipts & Tax" if
#    taken), primary language English (Australia), bundle ID
#    app.snapceipt.Snapceipt, SKU snapceipt-ios.
CONFIRM_ASC_APP_CREATED=no
# If "Snapceipt" was taken, write the app name you actually used:
ASC_APP_NAME=Snapceipt

# ---- Later steps (nothing to fill here) ----------------------------------------
# TestFlight Test Information + the external "Beta" group + testers (Task 14),
# the on-device Debug smoke test (Task 13), and the beta smoke checklist
# (Task 16) are interactive — Claude will walk you through them once the
# backend and site are live.
