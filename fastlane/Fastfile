default_platform(:ios)

platform :ios do
  # All lanes auth via the ASC API key — never interactive Apple ID + 2FA.
  private_lane :asc_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH")
    )
  end

  desc "Sync App Store signing certs/profiles (first run creates them; new machines pull them)"
  lane :certs do
    match(type: "appstore", readonly: false, api_key: asc_api_key)
  end

  desc "Distribute the latest already-uploaded build to the external 'Beta' group (no rebuild)"
  lane :distribute do
    pilot(
      api_key: asc_api_key,
      distribute_only: true,
      distribute_external: true,
      groups: ["Beta"],
      changelog: ENV["BETA_CHANGELOG"] || prompt(text: "Changelog for this build: ")
    )
  end

  desc "Upload app-listing metadata only from ./metadata (no binary, no screenshots, NO submission)"
  lane :metadata do
    deliver(
      api_key: asc_api_key,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      metadata_path: "./metadata",
      run_precheck_before_submit: false,
      submit_for_review: false,
      force: true # skip the interactive HTML preview/confirmation
    )
  end

  desc "Build and upload a TestFlight beta to the external 'Beta' group"
  lane :beta do
    ensure_git_status_clean
    # Ask now, not after the 10-minute build (spec §7: prompted at run time;
    # BETA_CHANGELOG env var for non-interactive runs).
    changelog = ENV["BETA_CHANGELOG"] || prompt(text: "Changelog for this build: ")
    # project.yml is the source of truth; the .xcodeproj is gitignored.
    sh("cd .. && xcodegen generate")
    api_key = asc_api_key
    match(type: "appstore", readonly: true, api_key: api_key)
    # Build numbers come from TestFlight, not local state — nothing to drift.
    build_num = latest_testflight_build_number(api_key: api_key, initial_build_number: 0) + 1
    gym(
      scheme: "Snapceipt",
      export_method: "app-store",
      # Optional disambiguation when the keychain holds multiple
      # "Apple Distribution" identities (e.g. an Xcode-created duplicate):
      # set CODESIGN_IDENTITY in fastlane/.env to the match cert's SHA-1.
      codesigning_identity: ENV["CODESIGN_IDENTITY"],
      xcargs: "CURRENT_PROJECT_VERSION=#{build_num} DEVELOPMENT_TEAM=#{ENV.fetch("FASTLANE_TEAM_ID")}",
      export_options: {
        provisioningProfiles: {
          "app.snapceipt.Snapceipt" => "match AppStore app.snapceipt.Snapceipt",
          "app.snapceipt.Snapceipt.ShareExtension" => "match AppStore app.snapceipt.Snapceipt.ShareExtension"
        },
        # Same duplicate-cert disambiguation for the export re-sign step
        # (accepts a SHA-1 hash); .compact drops it when the env is unset.
        signingCertificate: ENV["CODESIGN_IDENTITY"]
      }.compact
    )
    # BETA_INTERNAL_ONLY=1 uploads without an external submission — internal
    # groups get the build instantly and the one-per-train external review
    # slot stays with the build already under review.
    pilot_opts = { api_key: api_key, changelog: changelog }
    if ENV["BETA_INTERNAL_ONLY"] == "1"
      pilot_opts[:distribute_external] = false
    else
      pilot_opts[:groups] = ["Beta"]
      pilot_opts[:distribute_external] = true
    end
    pilot(**pilot_opts)
  end

  desc "GA: build the App Store binary, upload binary+metadata+screenshots, submit for phased review"
  lane :release do
    ensure_git_status_clean
    # project.yml is the source of truth; the .xcodeproj is gitignored.
    sh("cd .. && xcodegen generate")
    api_key = asc_api_key
    match(type: "appstore", readonly: true, api_key: api_key)
    # Build number must lead TestFlight (App Store rejects a re-used build number).
    build_num = latest_testflight_build_number(api_key: api_key, initial_build_number: 0) + 1
    gym(
      scheme: "Snapceipt",
      export_method: "app-store",
      codesigning_identity: ENV["CODESIGN_IDENTITY"],
      xcargs: "CURRENT_PROJECT_VERSION=#{build_num} DEVELOPMENT_TEAM=#{ENV.fetch("FASTLANE_TEAM_ID")}",
      export_options: {
        provisioningProfiles: {
          "app.snapceipt.Snapceipt" => "match AppStore app.snapceipt.Snapceipt",
          "app.snapceipt.Snapceipt.ShareExtension" => "match AppStore app.snapceipt.Snapceipt.ShareExtension"
        },
        signingCertificate: ENV["CODESIGN_IDENTITY"]
      }.compact
    )
    upload_to_app_store(
      api_key: api_key,
      # Upload the .ipa gym just built (skip the long binary re-build).
      ipa: lane_context[SharedValues::IPA_OUTPUT_PATH],
      # Author metadata/screenshots from the repo; never pull from ASC.
      skip_metadata: false,
      skip_screenshots: false,
      metadata_path: "./metadata",
      screenshots_path: "./screenshots",
      # Submit straight into App Review. Phased release is OMITTED entirely: it applies to
      # UPDATES, not a first release, and passing it either way (true=create / false=remove) hits
      # an ASC endpoint that returns "No data" on the first version (fastlane#20538). Re-add
      # `phased_release: true` for 1.x updates.
      submit_for_review: true,
      # Reset ratings only on explicit request — keep history across updates.
      reset_ratings: false,
      # Precheck/non-interactive guards for CI.
      run_precheck_before_submit: true,
      # Precheck can't check IAPs with an ASC API key (only Apple-ID login) — exclude them.
      precheck_include_in_app_purchases: false,
      force: true, # skip the HTML preview/confirmation prompt
      submission_information: {
        # No IDFA / ad tracking — mirrors PrivacyInfo.xcprivacy NSPrivacyTracking=false.
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false
      }
    )
  end

  desc "Submit an UPDATE for review: attach an already-uploaded build + push metadata, NO rebuild"
  # Usage: SUBMIT_VERSION=1.0.1 SUBMIT_BUILD=64 bundle exec fastlane submit_update
  # The appStoreVersion for SUBMIT_VERSION must already exist (create it first). deliver
  # attaches the build, uploads name/subtitle/keywords/release-notes from ./metadata, submits.
  lane :submit_update do
    api_key = asc_api_key
    upload_to_app_store(
      api_key: api_key,
      app_version: ENV.fetch("SUBMIT_VERSION"),
      build_number: ENV.fetch("SUBMIT_BUILD"),
      skip_binary_upload: true,   # binary already uploaded via `beta`
      skip_screenshots: true,     # unchanged from the live version
      skip_metadata: false,       # push name/subtitle/keywords/release_notes from ./metadata
      metadata_path: "./metadata",
      submit_for_review: true,
      reset_ratings: false,
      run_precheck_before_submit: true,
      precheck_include_in_app_purchases: false,
      force: true,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false
      }
    )
  end
end
