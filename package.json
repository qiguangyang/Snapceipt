{
  "name": "snapceipt-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node -e \"const v=require('child_process').execSync('wrangler --version').toString().match(/(\\\\d+)\\\\.\\\\d+\\\\.\\\\d+/);if(!v||+v[1]<4){console.error('wrangler v4+ required for deploy (found '+(v?v[0]:'none')+'): run npm i -D wrangler@4');process.exit(1)}\" && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "cf-typegen": "wrangler types",
    "migrate:local": "wrangler d1 migrations apply snapceipt --local",
    "migrate:remote": "wrangler d1 migrations apply snapceipt --remote"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.3",
    "@peculiar/x509": "^2.0.0",
    "hono": "^4.12.23",
    "jose": "^5.10.0",
    "mimetext": "^3.0.28",
    "pdf-lib": "^1.17.1",
    "postal-mime": "^2.4.3",
    "reflect-metadata": "^0.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.71",
    "@cloudflare/workers-types": "^4.20260529.1",
    "typescript": "^5.6.0",
    "vitest": "~2.1.9",
    "wrangler": "^4.25.0"
  }
}
